# Copy your PREVIOUS backend/.env here to use existing MongoDB data.
# If none exists, npm run dev will create backend/.env with a unique JWT secret
# and this local development database address.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/civicconnect
JWT_SECRET=replace-with-your-own-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
BCRYPT_ROUNDS=12
# For new installs only, temporarily add these when using npm run seed:
# SEED_ADMIN_NAME=Example Administrator
# SEED_ADMIN_EMAIL=admin@example.invalid
# SEED_ADMIN_PASSWORD=use-a-unique-strong-password
